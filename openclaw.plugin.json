{
  "id": "opencode-jev",
  "name": "OpenCode Jev",
  "description": "Typed decision provider for OpenCode Jev models.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "decisionProviders": [
      "opencode-jev"
    ],
    "tools": []
  },
  "decisionModels": [
    {
      "provider": "opencode-jev",
      "id": "jev-1.13-free",
      "name": "Jev 1.13 Free (OpenCode)",
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "opencode-jev",
      "id": "jev-1.13",
      "name": "Jev 1.13 (OpenCode)",
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "opencode-jev",
      "id": "jev-1.14",
      "name": "Jev 1.14 (OpenCode)",
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    }
  ],
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "description": "OpenCode API key or SecretRef. Optional for jev-1.13-free.",
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "store",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        ]
      },
      "keyFile": {
        "type": "string",
        "minLength": 1,
        "description": "Path to a 0600 file containing the OpenCode API key."
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000,
        "default": 25000
      }
    }
  }
}
